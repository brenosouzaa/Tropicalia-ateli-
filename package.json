{
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.1.0",
    "firebase-admin": "13.4.0",
    "firebase-tools": "14.17.0"
  },
  "name": "tropicalia-atelie",
  "private": true,
  "version": "1.0.0",
  "description": "Vitrine artesanal com Firebase, galeria e painel administrativo.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/core.test.mjs tests/refinements.test.mjs tests/access.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tropicalia 'node --test tests/firestore.rules.test.mjs'",
    "check": "node --check dist/app.mjs && node --check dist/firebase.mjs",
    "dev": "python3 -m http.server 4173 --directory dist",
    "grant-admin": "node scripts/grant-admin.mjs"
  }
}
